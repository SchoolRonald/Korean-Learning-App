# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Needed for sentence mode. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Needed only to rebuild the grammar curriculum. Get one at https://krdict.korean.go.kr/eng/openApi/openApiRegister
KRDICT_API_KEY=

# Fast grading of free answers (TypeSafe Jev). Optional: without it, Haiku grades.
JEV_API_KEY=

# Max AI calls per server run (optional, default 500)
GONGBU_LLM_CAP=500

# Database file (optional, default gongbu.db)
# GONGBU_DB=gongbu.db
